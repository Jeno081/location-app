# ============================================
# Location App — variables d'environnement
# Copiez ce fichier en .env puis complétez les valeurs.
# ============================================

NODE_ENV=development
PORT=3000

# Secret de signature des sessions (64 caractères aléatoires recommandés)
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=changez-moi-par-un-secret-long-et-aleatoire
JWT_EXPIRES_IN=7d

# --- Base de données MySQL -------------------------------------------------
# Valeurs fournies par l'add-on MySQL Clever Cloud (onglet « Informations »).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=location_app

# TLS : false avec le proxy Clever Cloud, true si votre hébergeur l'exige.
DB_SSL=false
# DB_SSL_CA=/chemin/vers/ca.pem
DB_POOL_SIZE=2

# Variante : une seule URL de connexion (prioritaire sur DB_*)
# DB_URI=mysql://utilisateur:motdepasse@hote:3306/base

# Les variables Clever Cloud sont aussi reconnues directement :
# MYSQL_ADDON_HOST=...
# MYSQL_ADDON_PORT=...
# MYSQL_ADDON_DB=...
# MYSQL_ADDON_USER=...
# MYSQL_ADDON_PASSWORD=...

# --- Fichiers --------------------------------------------------------------
# Dossier des photos, preuves et pièces d'identité.
# En production, pointez-le vers un disque persistant (Render Disk, volume…).
# UPLOAD_DIR=/var/data/uploads

# --- Notifications push (Firebase Cloud Messaging) ------------------------
# Console Firebase > Paramètres du projet > Comptes de service >
# Générer une nouvelle clé privée. Collez les valeurs du fichier JSON ici.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Conservez les \n dans la clé (chaîne sur une seule ligne).
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREMPLACER\n-----END PRIVATE KEY-----\n"

# Variante : JSON complet encodé en base64 (prioritaire si défini).
# FIREBASE_SERVICE_ACCOUNT_JSON=

# URL publique utilisée dans les notifications et le bouton « Ouvrir ».
# En local : http://localhost:3000 — en production : URL Render.
APP_URL=http://localhost:3000
