# ============================================
# Location App — variables d'environnement
# Copiez ce fichier en .env puis complétez les valeurs.
# ============================================

NODE_ENV=development
PORT=3000

# --- Identité de l'instance (branding par client) --------------------------
APP_NAME=Location App
APP_SHORT_NAME=Location App
APP_COMPANY_NAME=Location App
APP_TAGLINE=Gestion locative
APP_DESCRIPTION=Location App — gérez vos biens, contrats, loyers et locataires.
APP_URL=http://localhost:3000
CLIENT_SLUG=client-test
APP_SUPPORT_EMAIL=
APP_SUPPORT_PHONE=

# Langue par défaut : fr ou en. Locale Intl et devise de l'instance.
APP_DEFAULT_LANGUAGE=fr
APP_LOCALE=fr-FR
APP_CURRENCY=USD
APP_CURRENCY_SYMBOL=$
APP_TIMEZONE=Africa/Kinshasa

# URLs publiques des éléments de marque (Cloudinary ou fichiers statiques).
APP_LOGO_URL=/icons/logo.png
APP_ICON_192_URL=/icons/icon-192.png
APP_ICON_512_URL=/icons/icon-512.png
APP_ICON_MASKABLE_URL=/icons/maskable-512.png
APP_APPLE_ICON_URL=/icons/apple-touch-icon.png
APP_FAVICON_URL=/icons/favicon-32.png

# Couleurs de l'interface (format #RRGGBB).
APP_PRIMARY_COLOR=#4f46e5
APP_ACCENT_COLOR=#14b8a6
APP_THEME_COLOR=#0b1220
APP_BACKGROUND_COLOR=#000000


# Secret de signature des sessions (64 caractères aléatoires recommandés)
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=changez-moi-par-un-secret-long-et-aleatoire
JWT_EXPIRES_IN=7d

# --- Base de données MySQL -------------------------------------------------
# Valeurs fournies par l'add-on MySQL Clever Cloud (onglet « Informations »).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=location_app

# TLS : false avec le proxy Clever Cloud, true si votre hébergeur l'exige.
DB_SSL=false
# DB_SSL_CA=/chemin/vers/ca.pem
DB_POOL_SIZE=2

# Variante : une seule URL de connexion (prioritaire sur DB_*)
# DB_URI=mysql://utilisateur:motdepasse@hote:3306/base

# Les variables Clever Cloud sont aussi reconnues directement :
# MYSQL_ADDON_HOST=...
# MYSQL_ADDON_PORT=...
# MYSQL_ADDON_DB=...
# MYSQL_ADDON_USER=...
# MYSQL_ADDON_PASSWORD=...

# --- Fichiers --------------------------------------------------------------
# Dossier des photos, preuves et pièces d'identité.
# En production, pointez-le vers un disque persistant (Render Disk, volume…).
# UPLOAD_DIR=/var/data/uploads

# --- Notifications push (Firebase Cloud Messaging) ------------------------
# Console Firebase > Paramètres du projet > Comptes de service >
# Générer une nouvelle clé privée. Collez les valeurs du fichier JSON ici.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Conservez les \n dans la clé (chaîne sur une seule ligne).
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREMPLACER\n-----END PRIVATE KEY-----\n"

# Variante : JSON complet encodé en base64 (prioritaire si défini).
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Configuration Web Firebase (publique) servie dynamiquement par /firebase-config.js.
# Elle doit appartenir au même projet que le compte de service ci-dessus.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_VAPID_KEY=

