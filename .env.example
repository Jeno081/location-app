# Copiez ce fichier vers .env et adaptez les valeurs.
NODE_ENV=development
PORT=3000

# Obligatoire en production : au moins 32 caractères aléatoires.
# Générez-le avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Facultatif — valeurs par défaut :
# DB_PATH=./backend/database/location.sqlite
# UPLOAD_DIR=./backend/uploads
